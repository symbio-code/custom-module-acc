# Railway / Production Postgres template (placeholders).
# DO NOT commit real secrets. Set actual values in Railway environment
# variables or your deployment's secret manager.

DATABASE_PUBLIC_URL="postgresql://${PGUSER}:${PGPASSWORD}@${RAILWAY_TCP_PROXY_DOMAIN}:${RAILWAY_TCP_PROXY_PORT}/${PGDATABASE}"
DATABASE_URL="postgresql://${PGUSER}:${PGPASSWORD}@${RAILWAY_PRIVATE_DOMAIN}:5432/${PGDATABASE}"
PGDATA="/var/lib/postgresql/data/pgdata"
PGDATABASE="${POSTGRES_DB}"
PGHOST="${RAILWAY_PRIVATE_DOMAIN}"
PGPASSWORD="${POSTGRES_PASSWORD}"
PGPORT="5432"
PGUSER="${POSTGRES_USER}"
POSTGRES_DB="railway"
# POSTGRES_PASSWORD should be provided via Railway secrets (leave empty here)
POSTGRES_PASSWORD=""
POSTGRES_USER="postgres"
RAILWAY_DEPLOYMENT_DRAINING_SECONDS="60"
SSL_CERT_DAYS="820"